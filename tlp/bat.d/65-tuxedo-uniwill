#!/bin/sh
# 65-tuxedo-uniwill - Battery Plugin for TUXEDO laptops on the Uniwill EC path
#
# Covers TUXEDO/Uniwill barebones (validated on: InfinityBook Pro AMD Gen9,
# board "GXxHRXx") where charge control is a coarse 3-level EC "charging
# profile", not a percentage threshold pair like Clevo-chassis TUXEDOs.
#
# Requires tuxedo-drivers' uniwill_wmi + tuxedo_keyboard kernel modules bound
# -- NOT the in-tree uniwill_laptop module, which claims the same WMI GUIDs
# and wins if loaded first. tuxedo-drivers ships a modprobe blacklist for
# this (tuxedo-drivers-backlist-upstream-conflicts.conf); a clean boot with
# that file in place is enough for uniwill_wmi to bind instead.
#
# sysfs: /sys/devices/platform/tuxedo_keyboard/charging_profile/charging_profile
#        values: high_capacity | balanced | stationary
#
# This file is sourced before the generic 70-tuxedo plugin (numeric order),
# so on hardware where it matches, 70-tuxedo (which looks for Clevo's
# charge_control_start/end_threshold and would otherwise claim any TUXEDO
# vendor machine unconditionally) is never reached.
#
# Mapping onto TLP's START/STOP_CHARGE_THRESH_BAT0/1 config keys -- this EC
# has no independent start threshold, only one enum knob, so only the stop
# value is meaningful. Percentages per infinitybook-acpi's live-verified
# reading (this project's sibling repo for the NixOS side of this same
# machine), not a guess:
#   STOP_CHARGE_THRESH <= 85   -> stationary    (80%, most protective)
#   STOP_CHARGE_THRESH <= 95   -> balanced      (90%, mixed battery + AC)
#   STOP_CHARGE_THRESH >  95   -> high_capacity (100%, no protection, driver default)
# START_CHARGE_THRESH is accepted but has no effect on this hardware.
#
# SPDX-License-Identifier: GPL-2.0-or-later

# Needs: tlp-func-base, 35-tlp-func-batt, tlp-func-stat

UNIWILL_CHARGE_FILE=/sys/devices/platform/tuxedo_keyboard/charging_profile/charging_profile

# --- Hardware Detection

batdrv_is_tuxedo_uniwill () {
    # check DMI vendor + presence of the uniwill charging_profile sysfs node
    # rc: 0=ok, 1=other hardware
    [ "$(read_dmi sys_vendor)" = "TUXEDO" ] && [ -w "$UNIWILL_CHARGE_FILE" ]
}

# --- Plugin API functions

batdrv_init () {
    _batdrv_plugin="tuxedo-uniwill"
    _batdrv_kmod="uniwill_wmi"
    _batdrv_sim=0

    if [ -n "$X_BAT_PLUGIN_SIMULATE" ]; then
        if [ "$X_BAT_PLUGIN_SIMULATE" = "$_batdrv_plugin" ]; then
            echo_debug "bat" "batdrv_init.${_batdrv_plugin}.simulate"
            _batdrv_sim=1
        else
            echo_debug "bat" "batdrv_init.${_batdrv_plugin}.simulate_skip"
            return 1
        fi
    elif wordinlist "$_batdrv_plugin" "$X_BAT_PLUGIN_DENYLIST"; then
        echo_debug "bat" "batdrv_init.${_batdrv_plugin}.denylist"
        return 1
    else
        if ! batdrv_is_tuxedo_uniwill; then
            echo_debug "bat" "batdrv_init.${_batdrv_plugin}.no_match"
            return 1
        fi
    fi

    _natacpi=0
    _bm_read="native"
    _bm_thresh="uniwill_profile"
    _bm_dischg="none"
    _batteries=""
    _bt_def_start=0
    _bt_def_stop=100
    _bt_set_start="0"
    _bt_set_stop="80 90 100"

    local bd bs
    for bd in "$ACPIBATDIR"/BAT[01]; do
        if [ "$(read_sysf "$bd/present")" = "1" ]; then
            bs="${bd##/*/}"
            _batteries="${_batteries}${_batteries:+ }${bs}"
        fi
    done

    if [ -z "$_batteries" ]; then
        echo_debug "bat" "batdrv_init.${_batdrv_plugin}.no_batteries"
        return 2
    fi

    # shellcheck disable=SC2034
    _batdrv_selected=$_batdrv_plugin
    echo_debug "bat" "batdrv_init.${_batdrv_plugin}: batteries=$_batteries; thresh=$_bm_thresh"
    return 0
}

batdrv_select_battery () {
    # $1: BAT0/BAT1/DEF
    _bat_str=""
    _bt_cfg_bat=""
    _bd_read=""

    local bat="$1"
    bat="$(printf '%s' "$bat" | tr "[:lower:]" "[:upper:]")"

    case "$bat" in
        DEF) _bat_str="${_batteries%% *}" ;;
        *)
            if wordinlist "$bat" "$_batteries"; then
                _bat_str="$bat"
            else
                echo_debug "bat" "batdrv.${_batdrv_plugin}.select_battery($1).not_present"
                return 1
            fi
            ;;
    esac

    _bt_cfg_bat="$_bat_str"
    _bd_read="$ACPIBATDIR/$_bat_str"
    return 0
}

uniwill_profile_to_pct () {
    case "$1" in
        stationary)    printf "80"  ;;
        balanced)      printf "90"  ;;
        high_capacity) printf "100" ;;
        *)             printf ""    ;;
    esac
}

uniwill_pct_to_profile () {
    # $1: desired stop threshold, snapped to the nearest supported profile
    if [ "$1" -le 85 ] 2>/dev/null; then
        printf "stationary"
    elif [ "$1" -le 95 ] 2>/dev/null; then
        printf "balanced"
    else
        printf "high_capacity"
    fi
}

batdrv_read_threshold () {
    # $1: start/stop, $2: 0=api/1=tlp-stat output
    local cur pct

    case "$1" in
        start)
            [ "$2" = "1" ] && printf "(n/a on this EC)" || printf "0"
            return 0
            ;;
        stop)
            if ! cur=$(read_sysf "$UNIWILL_CHARGE_FILE"); then
                [ "$2" = "1" ] && printf "(not available)"
                return 4
            fi
            pct=$(uniwill_profile_to_pct "$cur")
            printf "%s" "$pct"
            return 0
            ;;
    esac
}

batdrv_write_thresholds () {
    # $1: start (accepted, ignored -- no hardware equivalent)
    # $2: new stop threshold: 80/90/100(default)/DEF
    # $3: 0=quiet/1=output parameter errors/2=output progress and errors
    # $4: non-empty string indicates thresholds stem from configuration
    local new_stop="${2:-}"
    local profile old_profile

    [ "$new_stop" = "DEF" ] && new_stop=$_bt_def_stop

    if [ -n "$4" ] && [ -z "$new_stop" ]; then
        echo_debug "bat" "batdrv.${_batdrv_plugin}.write_thresholds($1, $2, $3, $4).not_configured"
        return 1
    fi

    if ! is_uint "$new_stop" 3 || ! wordinlist "$new_stop" "$_bt_set_stop"; then
        echo_debug "bat" "batdrv.${_batdrv_plugin}.write_thresholds($1, $2, $3, $4).invalid_stop"
        case "$3" in
            1)
                [ -n "$4" ] && echo_message "Error in configuration at STOP_CHARGE_THRESH_${_bt_cfg_bat}=\"${new_stop}\": not specified, invalid or not in {80, 90, 100}. Battery skipped."
                ;;
            2)
                cprintf "" "Error: stop charge threshold (%s) for %s is not specified, invalid or not in {80, 90, 100}. Aborted.\n" "$new_stop" "$_bat_str" 1>&2
                ;;
        esac
        return 2
    fi

    profile=$(uniwill_pct_to_profile "$new_stop")
    old_profile=$(read_sysf "$UNIWILL_CHARGE_FILE")

    if [ "$old_profile" = "$profile" ]; then
        [ "$3" = "2" ] && printf "  stop  = %3d (no change, profile=%s)\n" "$new_stop" "$profile" 1>&2
        echo_debug "bat" "batdrv.${_batdrv_plugin}.write_thresholds($1, $2, $3, $4).no_change: profile=$profile"
        return 0
    fi

    if [ "$_batdrv_sim" = "1" ]; then
        [ "$3" = "2" ] && printf "  stop  = %3d (simulated, profile=%s)\n" "$new_stop" "$profile" 1>&2
        return 0
    fi

    if write_sysf "$profile" "$UNIWILL_CHARGE_FILE"; then
        [ "$3" = "2" ] && printf "  stop  = %3d (profile=%s)\n" "$new_stop" "$profile" 1>&2
        echo_debug "bat" "batdrv.${_batdrv_plugin}.write_thresholds($1, $2, $3, $4).write: old=$old_profile new=$profile"
        return 0
    else
        case "$3" in
            1) echo_message "Error: writing charging profile ($profile) for $_bat_str failed." ;;
            2) cprintf "" "Error: writing charging profile (%s) for %s failed.\n" "$profile" "$_bat_str" 1>&2 ;;
        esac
        return 5
    fi
}

batdrv_calc_soc () {
    soc_calc "$1"
}

batdrv_chargeonce () {
    echo_debug "bat" "batdrv.${_batdrv_plugin}.charge_once.not_implemented"
    return 255
}

batdrv_apply_configured_thresholds () {
    local bat stop_thresh

    for bat in BAT0 BAT1; do
        if batdrv_select_battery "$bat"; then
            eval stop_thresh="\$STOP_CHARGE_THRESH_${_bt_cfg_bat}"
            batdrv_write_thresholds "" "$stop_thresh" 1 1
        fi
    done

    return 0
}

batdrv_read_force_discharge () {
    echo_debug "bat" "batdrv.${_batdrv_plugin}.read_force_discharge.not_implemented"
    return 255
}

batdrv_write_force_discharge () {
    echo_debug "bat" "batdrv.${_batdrv_plugin}.write_force_discharge.not_implemented"
    return 255
}

batdrv_cancel_force_discharge () {
    echo_debug "bat" "batdrv.${_batdrv_plugin}.cancel_force_discharge.not_implemented"
    return 255
}

batdrv_force_discharge_active () {
    echo_debug "bat" "batdrv.${_batdrv_plugin}.force_discharge_active.not_implemented"
    return 255
}

batdrv_discharge_safetylock () {
    return 1
}

batdrv_discharge () {
    unlock_tlp tlp_discharge
    echo_debug "bat" "batdrv.${_batdrv_plugin}.discharge.not_implemented"
    return 255
}

batdrv_show_battery_data () {
    local verbose="${1:-0}"

    printf "+++ Battery Care\n"
    printf "Plugin: %s\n" "$_batdrv_plugin"
    cprintf "success" "Supported features: charging profile (coarse, 3-level)\n"
    printf "Driver usage:\n"
    cprintf "success" "* %s (tuxedo_keyboard) = active (charging_profile)\n" "$_batdrv_kmod"
    printf "Parameter value ranges:\n"
    printf "* START_CHARGE_THRESH_BAT0/1:  not supported by this EC (ignored)\n"
    printf "* STOP_CHARGE_THRESH_BAT0/1:   80(stationary)/90(balanced)/100(high_capacity, default)\n"
    printf "\n"

    local bat bcnt=0
    for bat in $_batteries; do
        batdrv_select_battery "$bat"

        printf "+++ Battery Status: %s\n" "$bat"
        print_bat_make "$verbose"
        print_bat_cycle_count "$_bd_read/cycle_count"
        print_bat_energy "$verbose"
        print_bat_state "$_bd_read/status"
        printf "\n"
        print_bat_voltages "$verbose"
        printf "%-59s = %s\n" "$UNIWILL_CHARGE_FILE" "$(read_sysf "$UNIWILL_CHARGE_FILE")"
        printf "\n"
        print_bat_level

        bcnt=$((bcnt+1))
    done

    [ $bcnt -gt 1 ] && print_bat_level_total

    return 0
}

batdrv_check_soc_gt_stop () {
    local soc stop

    if soc="$(batdrv_calc_soc)"; then
        stop="$(batdrv_read_threshold stop 0)"
        if [ -n "$stop" ] && [ "$soc" -gt "$stop" ]; then
            return 0
        fi
    fi

    return 1
}

batdrv_recommendations () {
    soc_gt_stop_recommendation
    return 0
}
