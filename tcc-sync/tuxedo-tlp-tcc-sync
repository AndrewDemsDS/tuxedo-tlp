#!/usr/bin/env python3
# tuxedo-tlp-tcc-sync - follow TLP's power profile with a TCC profile.
#
# TLP owns the CPU (TCC's cpuSettingsEnabled=false); TCC keeps fans, ODM
# profile, keyboard and display brightness. When TLP switches to power-saver,
# this asks tccd for its "Powersave extreme" temp profile (silent fans, 60%
# brightness); on balanced/performance it switches back to the profile TCC's
# own stateMap picks for the current power source.
#
# Triggers: tlp-pd's PropertiesChanged on ActiveProfile, a second check a few
# seconds later (tccd resets the temp profile on AC/battery changes and races
# TLP's own auto-switch), and a slow safety poll that also covers tccd
# restarts.
#
# SPDX-License-Identifier: MIT

import json
import os
import select
import subprocess
import sys
import time

PPD = ["net.hadess.PowerProfiles", "/net/hadess/PowerProfiles", "net.hadess.PowerProfiles"]
TCC = ["com.tuxedocomputers.tccd", "/com/tuxedocomputers/tccd", "com.tuxedocomputers.tccd"]

SAV_PROFILE = os.environ.get("TCC_SAV_PROFILE", "__legacy_powersave_extreme__")
RESYNC_DELAY = float(os.environ.get("RESYNC_DELAY", "4"))
POLL_INTERVAL = float(os.environ.get("POLL_INTERVAL", "60"))


def log(msg):
    print(msg, flush=True)


def busctl(*args):
    out = subprocess.run(["busctl", "--json=short", *args],
                         capture_output=True, text=True, timeout=10)
    if out.returncode != 0:
        raise RuntimeError(out.stderr.strip() or f"busctl {args[0]} failed")
    return json.loads(out.stdout)["data"]


def tlp_profile():
    return busctl("get-property", *PPD, "ActiveProfile")


def tcc_call(method, *args):
    sig = ["s"] if args else []
    return busctl("call", *TCC, method, *sig, *args)[0]


def on_ac():
    base = "/sys/class/power_supply"
    for name in os.listdir(base):
        try:
            with open(f"{base}/{name}/type") as f:
                if f.read().strip() != "Mains":
                    continue
            with open(f"{base}/{name}/online") as f:
                if f.read().strip() == "1":
                    return True
        except OSError:
            pass
    return False


def wanted_tcc_profile(profile):
    if profile == "power-saver":
        return SAV_PROFILE
    state_map = json.loads(tcc_call("GetSettingsJSON"))["stateMap"]
    return state_map["power_ac" if on_ac() else "power_bat"]


def sync(reason):
    try:
        profile = tlp_profile()
        want = wanted_tcc_profile(profile)
        have = json.loads(tcc_call("GetActiveProfileJSON"))["id"]
        if have == want:
            return
        ok = tcc_call("SetTempProfileById", want)
        log(f"{reason}: TLP {profile} -> TCC {want} (was {have}){'' if ok else ' REJECTED'}")
    except (RuntimeError, OSError, KeyError, ValueError, subprocess.TimeoutExpired) as err:
        log(f"{reason}: sync skipped: {err}")


def main():
    mon = subprocess.Popen(
        ["gdbus", "monitor", "--system", "--dest", PPD[0], "--object-path", PPD[1]],
        stdout=subprocess.PIPE, text=True, bufsize=1)
    sync("start")
    next_poll = time.monotonic() + POLL_INTERVAL
    resync_at = None

    while True:
        deadline = min(next_poll, resync_at or next_poll)
        ready, _, _ = select.select([mon.stdout], [], [], max(0, deadline - time.monotonic()))
        now = time.monotonic()
        if ready:
            line = mon.stdout.readline()
            if not line:
                log("gdbus monitor exited")
                return 1
            if "ActiveProfile" in line:
                sync("profile change")
                resync_at = now + RESYNC_DELAY
            continue
        if resync_at is not None and now >= resync_at:
            sync("resync")
            resync_at = None
        if now >= next_poll:
            sync("poll")
            next_poll = now + POLL_INTERVAL


if __name__ == "__main__":
    sys.exit(main())
